# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

NODE_ENV=development
PORT=3001

# ------------------------------------------------------------
# DATABASE - POSTGRESQL
# ------------------------------------------------------------
DATABASE_URL=postgresql://collabwave_user:your_password@postgres:5432/collabwave
# Opcional. O default é true em production e false nos restantes ambientes.
DATABASE_SSL=false

DB_HOST=postgres
DB_PORT=5432
DB_NAME=collabwave
DB_USER=collabwave_user
DB_PASSWORD=your_password

# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------
# AUTHENTICATION — JWT
# ------------------------------------------------------------
# Secret key used to sign and verify JWT access tokens.
# SECURITY REQUIREMENTS (as per SRS section 2.2):
#   - Minimum 256 bits of entropy (32+ random characters)
#   - Must be different from JWT_REFRESH_SECRET
#   - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_minimum_256_bit_random_string

# Secret key used to sign and verify JWT refresh tokens.
# Must be a different value from JWT_SECRET.
JWT_REFRESH_SECRET=replace_with_a_different_256_bit_random_string

# Access token expiry duration.
# Short-lived for security — user re-authenticates via refresh token.
# Format follows the jsonwebtoken library: "15m", "1h", "7d", etc.
JWT_EXPIRES_IN=15m

# Refresh token expiry duration.
# Long-lived for security — user re-authenticates via refresh token.
# Format follows the jsonwebtoken library: "15m", "1h", "7d", etc.
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# FRONTEND — Vite Environment Variables
# ------------------------------------------------------------

# Base URL of the Socket.io server, used by socket.io-client.
VITE_SOCKET_URL=http://localhost:3001

# ------------------------------------------------------------
# RATE LIMITING — OPTIONAL
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SHUTDOWN_TIMEOUT_MS=10000
HEALTHCHECK_TIMEOUT_MS=2000
